API_KEY=troque-por-uma-chave-forte
SECRET_KEY=troque-por-outro-segredo-forte
DASHBOARD_PASSWORD=uma-senha-para-o-painel

MAX_SESSIONS=5
MAX_EVENTS=2500
MAX_PARTICIPANTS=2000

OFFLINE_RETRY_SECONDS=30
RECONNECT_BASE_SECONDS=5
RECONNECT_MAX_SECONDS=60

IGNORE_BROKEN_PAYLOAD=true
STORE_RAW_DIAGNOSTICS=true

# Monitor contextual: evita falso positivo de mensagens antigas recebidas ao conectar.
DIAGNOSTIC_HISTORICAL_GRACE_SECONDS=15
DIAGNOSTIC_FRESH_MAX_SECONDS=120
DIAGNOSTIC_STARTUP_QUARANTINE_SECONDS=20
DIAGNOSTIC_CORROBORATION_SECONDS=20
DIAGNOSTIC_REPEAT_SUPPRESS_SECONDS=30

# Opcional: reconectar contas automaticamente quando o processo acordar/reiniciar.
# Formato: usuario:perfil,usuario2:perfil
# Perfis: raw, dance, kite
AUTO_CONNECT_USERS=

# Opcional: chave Euler Stream para elevar limites do servidor de assinatura.
EULER_API_KEY=
